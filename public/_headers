/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://giscus.app https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://giscus.app https://api.github.com https://cloudflareinsights.com; frame-src 'self' https://giscus.app https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;
  Cache-Control: public, max-age=900, stale-while-revalidate=60

# Giscus custom themes
/giscus/*.css
  Content-Type: text/css
  Cache-Control: public, max-age=31536000, immutable

# Immutable static assets (Next.js)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static images (covers optimized and raw images)
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed note assets (cover images, attachments, optimized WebP variants)
/notes-assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts (rarely change)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The generated icon route (src/app/icon.tsx). Under a static export Next
# writes it to `out/icon` with no file extension, so Pages types it by
# extension and falls back to application/octet-stream — declare it here.
# Not needed in server mode, where Next sets the header itself.
# Only the content type: matching rules *combine* rather than override, so a
# Cache-Control here would append a second max-age to the one from `/*`
# instead of replacing it, and the first one wins regardless.
/icon
  Content-Type: image/png

# --- onvu:agents begin (generated, do not edit) ---
# Generated by onvu (agents.discovery.emitHeadersFile).
# Markdown mirrors: served inline, kept out of human search indexes.

/en/notes/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/de/notes/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/uk/notes/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

# The site index, discoverable from any page without parsing HTML.
# Scoped per locale rather than `/*` so it stays off static assets.

/en/*
  Link: </llms.txt>; rel="index"; type="text/plain"

/de/*
  Link: </llms.txt>; rel="index"; type="text/plain"

/uk/*
  Link: </llms.txt>; rel="index"; type="text/plain"

# Each note page points at its own markdown mirror.

/en/notes/:slug/
  Link: </en/notes/:slug.md>; rel="alternate"; type="text/markdown"

/de/notes/:slug/
  Link: </de/notes/:slug.md>; rel="alternate"; type="text/markdown"

/uk/notes/:slug/
  Link: </uk/notes/:slug.md>; rel="alternate"; type="text/markdown"

# Pages under /notes/ that are not notes: no mirror to point at.

/en/notes/graph/
  ! Link

/de/notes/graph/
  ! Link

/uk/notes/graph/
  ! Link
# --- onvu:agents end ---
